[configuration]

entry_symbol = "dao_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/dao.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/dao.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/dao.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/dao.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://bin/dao.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/dao.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/dao.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/dao.linux.template_release.arm64.so"
macos.debug = "res://bin/dao.macos.template_debug.framework"
macos.release = "res://bin/dao.macos.template_release.framework"
